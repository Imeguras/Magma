// 6x8 bitmap font for FPS overlay
// Indices: 0-9=digits, 10=F, 11=P, 12=S, 13=:, 14=., 15=(, 16=), 17=space
// Each char: 8 rows, 6 columns per row, LSB=leftmost column, only bits 0-5 used
static const unsigned char font_data[18 * 8] = {
    0x0E,0x21,0x21,0x21,0x21,0x21,0x0E,0x00, // 0
    0x04,0x0C,0x04,0x04,0x04,0x04,0x0E,0x00, // 1
    0x0E,0x21,0x01,0x02,0x04,0x08,0x1F,0x00, // 2
    0x0E,0x21,0x01,0x06,0x01,0x21,0x0E,0x00, // 3
    0x02,0x06,0x0A,0x12,0x1F,0x02,0x02,0x00, // 4
    0x1F,0x10,0x1E,0x01,0x01,0x21,0x0E,0x00, // 5
    0x0E,0x10,0x1E,0x21,0x21,0x21,0x0E,0x00, // 6
    0x1F,0x01,0x02,0x04,0x08,0x08,0x08,0x00, // 7
    0x0E,0x21,0x21,0x0E,0x21,0x21,0x0E,0x00, // 8
    0x0E,0x21,0x21,0x0F,0x01,0x21,0x0E,0x00, // 9
    0x1F,0x10,0x1E,0x10,0x10,0x10,0x10,0x00, // F
    0x1E,0x21,0x21,0x1E,0x10,0x10,0x10,0x00, // P
    0x0E,0x21,0x10,0x0E,0x01,0x21,0x0E,0x00, // S
    0x00,0x04,0x04,0x00,0x00,0x04,0x04,0x00, // :
    0x00,0x00,0x00,0x00,0x00,0x04,0x04,0x00, // .
    0x02,0x04,0x08,0x08,0x08,0x04,0x02,0x00, // (
    0x08,0x04,0x02,0x02,0x02,0x04,0x08,0x00, // )
    0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00, // space
};

extern "C" __global__ void fps_overlay_kernel(
    unsigned int* dst, int dst_stride,
    int img_w, int img_h,
    const unsigned char* text_idx,
    int text_len,
    int pos_x, int pos_y,
    unsigned int color)
{
    int c = blockIdx.x * blockDim.x + threadIdx.x;
    if (c >= text_len) return;

    int base_x = pos_x + c * 7;
    unsigned char idx = text_idx[c];

    for (int row = 0; row < 8; row++) {
        unsigned char bits = font_data[idx * 8 + row];
        int py = pos_y + row;
        if (py >= img_h) continue;
        for (int col = 0; col < 6; col++) {
            if (bits & (1 << (5 - col))) {
                int px = base_x + col;
                if (px >= 0 && px < img_w) {
                    dst[py * dst_stride + px] = color;
                }
            }
        }
    }
}
