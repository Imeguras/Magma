extern "C" {

__device__ static void draw_char(unsigned char* y_plane, unsigned char* uv_plane,
                                  int y_stride, int uv_stride,
                                  int x, int y, unsigned char c,
                                  unsigned char bg_y, unsigned char bg_u, unsigned char bg_v)
{
    if (c < 32 || c > 126) return;
    int ci = c - 32;
    for (int row = 0; row < 7; row++) {
        int yy = y + row;
        if (yy < 0) continue;
        unsigned char mask = font5x7[ci][row];
        for (int col = 0; col < 5; col++) {
            int xx = x + col;
            if (xx < 0) continue;
            if (mask & (1 << col)) {
                y_plane[yy * y_stride + xx] = 235;
                int ux = xx >> 1, uy = yy >> 1;
                uv_plane[uy * uv_stride + (ux << 1)    ] = 128;
                uv_plane[uy * uv_stride + (ux << 1) + 1] = 128;
            }
        }
    }
}

__global__ void draw_boxes_kernel(
    unsigned char* __restrict__ y_plane,
    unsigned char* __restrict__ uv_plane,
    int y_stride, int uv_stride,
    int img_w, int img_h,
    const BoxParam* __restrict__ boxes,
    int num_boxes, int line_width,
    int show_labels)
{
    int i = blockIdx.x * blockDim.x + threadIdx.x;
    if (i >= num_boxes) return;

    BoxParam b = boxes[i];
    int x1 = clampi(b.x, 0, img_w - 1);
    int y1 = clampi(b.y, 0, img_h - 1);
    int x2 = clampi(b.x + b.w - 1, 0, img_w - 1);
    int y2 = clampi(b.y + b.h - 1, 0, img_h - 1);

    /* top edge */
    for (int l = 0; l < line_width; l++) {
        int yy = y1 + l;
        if (yy > y2) break;
        for (int x = x1; x <= x2; x++) {
            y_plane[yy * y_stride + x] = b.y_val;
            int ux = x >> 1, uy = yy >> 1;
            uv_plane[uy * uv_stride + (ux << 1)    ] = b.u_val;
            uv_plane[uy * uv_stride + (ux << 1) + 1] = b.v_val;
        }
    }

    /* bottom edge */
    for (int l = 0; l < line_width; l++) {
        int yy = y2 - l;
        if (yy < y1) break;
        for (int x = x1; x <= x2; x++) {
            y_plane[yy * y_stride + x] = b.y_val;
            int ux = x >> 1, uy = yy >> 1;
            uv_plane[uy * uv_stride + (ux << 1)    ] = b.u_val;
            uv_plane[uy * uv_stride + (ux << 1) + 1] = b.v_val;
        }
    }

    /* left edge (skip corners) */
    for (int yy = y1 + line_width; yy <= y2 - line_width; yy++) {
        for (int l = 0; l < line_width; l++) {
            int xx = x1 + l;
            if (xx > x2) break;
            y_plane[yy * y_stride + xx] = b.y_val;
            int ux = xx >> 1, uy = yy >> 1;
            uv_plane[uy * uv_stride + (ux << 1)    ] = b.u_val;
            uv_plane[uy * uv_stride + (ux << 1) + 1] = b.v_val;
        }
    }

    /* right edge (skip corners) */
    for (int yy = y1 + line_width; yy <= y2 - line_width; yy++) {
        for (int l = 0; l < line_width; l++) {
            int xx = x2 - l;
            if (xx < x1) break;
            y_plane[yy * y_stride + xx] = b.y_val;
            int ux = xx >> 1, uy = yy >> 1;
            uv_plane[uy * uv_stride + (ux << 1)    ] = b.u_val;
            uv_plane[uy * uv_stride + (ux << 1) + 1] = b.v_val;
        }
    }

    /* label (top-right of box) */
    if (!show_labels) return;
    if (b.label[0] == 0) return;

    int label_len = 0;
    while (label_len < 7 && b.label[label_len]) label_len++;

    int char_w = 6;
    int label_h = 8;
    int label_w = label_len * char_w;

    int lx = x2 - label_w;
    if (lx < x1) lx = x1;
    int ly = y1 - label_h;
    if (ly < 0) ly = y1;

    if (lx + label_w > img_w) lx = img_w - label_w;
    if (lx < 0) lx = 0;
    if (ly + label_h > img_h) ly = img_h - label_h;
    if (ly < 0) ly = 0;

    for (int yy = ly; yy < ly + label_h; yy++) {
        if (yy >= img_h) break;
        for (int xx = lx; xx < lx + label_w; xx++) {
            if (xx >= img_w) break;
            y_plane[yy * y_stride + xx] = b.y_val;
            int ux = xx >> 1, uy = yy >> 1;
            uv_plane[uy * uv_stride + (ux << 1)    ] = b.u_val;
            uv_plane[uy * uv_stride + (ux << 1) + 1] = b.v_val;
        }
    }

    int cx = lx;
    for (int ci = 0; ci < label_len; ci++) {
        draw_char(y_plane, uv_plane, y_stride, uv_stride, cx, ly, b.label[ci], b.y_val, b.u_val, b.v_val);
        cx += char_w;
    }
}

}
